{
  "name": "billsoft",
  "version": "1.0.0",
  "description": "Billsoft Desktop Application",
  "author": "Ranjeet Yelave",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "clean": "rm -rf dist/win-unpacked dist/mac-arm64 dist/*.7z",
    "build:win": "npm run clean && electron-builder --win --x64",
    "build:win:arm64": "npm run clean && electron-builder --win --arm64",
    "build:mac": "npm run clean && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac"
  },
  "build": {
    "appId": "com.billing.simple.billsoft",
    "productName": "Billsoft",
    "mac": {
      "identity": null,
      "extraResources": [
        {
          "from": "../target/billsoft-0.0.1-SNAPSHOT.war",
          "to": "backend/billsoft.war"
        },
        {
          "from": "jre-mac",
          "to": "jre"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "extraResources": [
        {
          "from": "../target/billsoft-0.0.1-SNAPSHOT.war",
          "to": "backend/billsoft.war"
        },
        {
          "from": "jre-win",
          "to": "jre"
        }
      ]
    },
    "extraResources": [
      {
        "from": "../target/billsoft-0.0.1-SNAPSHOT.war",
        "to": "backend/billsoft.war"
      }
    ]
  },
  "devDependencies": {
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "wait-on": "^8.0.5"
  }
}