{
  "info": {
    "name": "Billsoft API Collection (Minimal Invoice Schema)",
    "_postman_id": "billsoft-minimal-collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Products",
      "item": [
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products"
          }
        },
        {
          "name": "Get Product by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products/1"
          }
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laptop\",\n  \"price\": 55000,\n  \"unit\": \"pcs\",\n  \"gstPercentage\": 18\n}"
            },
            "url": "{{baseUrl}}/api/products"
          }
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laptop Updated\",\n  \"price\": 56000,\n  \"unit\": \"pcs\",\n  \"gstPercentage\": 18\n}"
            },
            "url": "{{baseUrl}}/api/products/1"
          }
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/products/1"
          }
        }
      ]
    },
    {
      "name": "Customers",
      "item": [
        {
          "name": "Get All Customers",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/customers"
          }
        },
        {
          "name": "Create Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ranjeet\",\n  \"phone\": \"9999999999\",\n  \"email\": \"r@example.com\",\n  \"address\": \"Pune\"\n}"
            },
            "url": "{{baseUrl}}/api/customers"
          }
        }
      ]
    },
    {
      "name": "Invoices (Minimal Schema)",
      "item": [
        {
          "name": "Get All Invoices",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/invoices"
          }
        },
        {
          "name": "Get Invoice by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/invoices/1"
          }
        },
        {
          "name": "Create Invoice (Minimal)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": 1,\n  \"notes\": \"Sample invoice\",\n  \"items\": [\n    {\n      \"productId\": 1,\n      \"qty\": 2\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/invoices"
          }
        },
        {
          "name": "Update Invoice (Minimal)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": 1,\n  \"invoiceDate\": \"2025-01-01T10:00:00\",\n  \"notes\": \"Updated\",\n  \"items\": [\n    {\n      \"itemId\": 1,\n      \"qty\": 5,\n      \"productId\": 1\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/invoices/1"
          }
        },
        {
          "name": "Delete Invoice",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/invoices/1"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ]
}