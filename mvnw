#!/usr/bin/env bash
# Maven Wrapper script generated by Antigravity
# This script boots Maven using the wrapper jar.
set -e
# Directory of the wrapper jar
WRAPPER_DIR="$(cd "$(dirname "$0")" && pwd)/.mvn/wrapper"
WRAPPER_JAR="$WRAPPER_DIR/maven-wrapper.jar"
# Download wrapper jar if missing
if [ ! -f "$WRAPPER_JAR" ]; then
  echo "Downloading Maven wrapper..."
  curl -L -o "$WRAPPER_JAR" https://repo1.maven.org/maven2/io/takari/maven-wrapper/0.5.6/maven-wrapper-0.5.6.jar
fi
# Execute Maven
exec java -jar "$WRAPPER_JAR" "$@"
